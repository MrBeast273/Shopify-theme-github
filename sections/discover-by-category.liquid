<style>
  .aesop-category-section-{{ section.id }} {
    max-width: 1440px;
    margin: 0 auto;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 4%;
    padding-right: 4%;
    background-color: #fcfcf9; 
  }
  .aesop-heading-{{ section.id }} {
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 0.5px;
    margin-bottom: 40px;
    color: #222222;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
  .aesop-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(6, 1fr); 
    gap: 20px;
  }
  .aesop-card-{{ section.id }} {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }
  .aesop-image-wrapper-{{ section.id }} {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 16px;
    background-color: #eaeaea;
  }
  .aesop-image-wrapper-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .aesop-card-{{ section.id }}:hover img {
    transform: scale(1.04);
  }
  .aesop-title-{{ section.id }} {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.2px;
    color: #1a1a1a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    margin: 0;
  }
  @media (max-width: 1024px) {
    .aesop-grid-{{ section.id }} {
      grid-template-columns: repeat(3, 1fr); 
    }
  }
  @media (max-width: 600px) {
    .aesop-category-section-{{ section.id }} {
      padding-top: 40px;
      padding-bottom: 40px;
    }
    .aesop-grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .aesop-heading-{{ section.id }} {
      font-size: 20px;
      margin-bottom: 20px;
    }
    .aesop-title-{{ section.id }} {
      font-size: 13px;
    }
  }
</style>
<div class="aesop-category-section-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="aesop-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
  {% endif %}
  <div class="aesop-grid-{{ section.id }}">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: '#' }}" class="aesop-card-{{ section.id }}" {{ block.shopify_attributes }}>
        <div class="aesop-image-wrapper-{{ section.id }}">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 600 }}" 
                 alt="{{ block.settings.image.alt | escape }}" 
                 loading="lazy" 
                 width="{{ block.settings.image.width }}" 
                 height="{{ block.settings.image.height }}">
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        {% if block.settings.title != blank %}
          <h3 class="aesop-title-{{ section.id }}">{{ block.settings.title }}</h3>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Discover by Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover by category"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Skin Care"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Discover by Category",
      "blocks": [
        { "type": "category", "settings": { "title": "Skin Care" } },
        { "type": "category", "settings": { "title": "Hand & Body" } },
        { "type": "category", "settings": { "title": "Hair" } },
        { "type": "category", "settings": { "title": "Fragrance" } },
        { "type": "category", "settings": { "title": "Home" } },
        { "type": "category", "settings": { "title": "Kits & Travel" } }
      ]
    }
  ]
}
{% endschema %}