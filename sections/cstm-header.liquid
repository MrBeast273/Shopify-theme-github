<script>
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.querySelector('.aesop-modal');
    const openTriggers = document.querySelectorAll('[data-email-signup]');
    const closeTriggers = document.querySelectorAll('[data-email-modal-close]');

    if (modal) {
      openTriggers.forEach(trigger => {
        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          modal.classList.add('is-open');
          modal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      closeTriggers.forEach(trigger => {
        trigger.addEventListener('click', function() {
          modal.classList.remove('is-open');
          modal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        });
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) {
          modal.classList.remove('is-open');
          modal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      });
    }

    const cartDrawer = document.querySelector('[data-cart-drawer]');
    const cartOpenBtns = document.querySelectorAll('[data-cart-drawer-open]');
    const cartCloseBtns = document.querySelectorAll('[data-cart-close]');

    if (cartDrawer) {
      cartOpenBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          cartDrawer.classList.add('is-open');
          cartDrawer.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      cartCloseBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          cartDrawer.classList.remove('is-open');
          cartDrawer.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        });
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && cartDrawer.classList.contains('is-open')) {
          cartDrawer.classList.remove('is-open');
          cartDrawer.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      });

      cartDrawer.querySelectorAll('[data-cart-qty-plus]').forEach(btn => {
        btn.addEventListener('click', function() {
          const key = this.dataset.key;
          const input = cartDrawer.querySelector(`[data-cart-qty-input][data-key="${key}"]`);
          updateCartItem(key, parseInt(input.value) + 1);
        });
      });

      cartDrawer.querySelectorAll('[data-cart-qty-minus]').forEach(btn => {
        btn.addEventListener('click', function() {
          const key = this.dataset.key;
          const input = cartDrawer.querySelector(`[data-cart-qty-input][data-key="${key}"]`);
          updateCartItem(key, Math.max(0, parseInt(input.value) - 1));
        });
      });

      function updateCartItem(key, quantity) {
        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: key, quantity: quantity })
        })
        .then(res => res.json())
        .then(cart => {
          refreshCartDrawer(cart);
          document.dispatchEvent(new CustomEvent('cart:updated'));
          window.dispatchEvent(new CustomEvent('cart:updated'));
        })
        .catch(err => console.error('Cart update error:', err));
      }

      function refreshCartDrawer(cart) {
        document.querySelectorAll('[data-cart-count]').forEach(el => el.textContent = cart.item_count);
        document.querySelectorAll('[data-cart-count-wrap]').forEach(el => {
          el.hidden = cart.item_count === 0;
        });
        document.querySelectorAll('[data-cart-drawer-count]').forEach(el => {
          el.textContent = cart.item_count > 0 ? `(${cart.item_count})` : '';
        });

        const body = cartDrawer.querySelector('[data-cart-body]');
        if (cart.item_count === 0) {
          body.innerHTML = `
            <div class="aesop-cart-drawer__empty">
              <p class="aesop-cart-drawer__empty-text">You have no items in your cart</p>
              <a href="/collections/all" class="aesop-cart-drawer__empty-btn">Continue shopping</a>
            </div>`;
        } else {
          let itemsHtml = '<div class="aesop-cart-drawer__items">';
          cart.items.forEach(item => {
            itemsHtml += `
              <div class="aesop-cart-drawer__item" data-cart-item="${item.key}">
                <div class="aesop-cart-drawer__item-image">
                  <a href="${item.url}">
                    <img src="${item.image}" alt="${item.title}" loading="lazy">
                  </a>
                </div>
                <div class="aesop-cart-drawer__item-details">
                  <a href="${item.url}" class="aesop-cart-drawer__item-title">${item.product_title}</a>
                  ${item.variant_title && item.variant_title !== 'Default Title' ? `<p class="aesop-cart-drawer__item-variant">Size: ${item.variant_title}</p>` : ''}
                  <div class="aesop-cart-drawer__item-bottom">
                    <div class="aesop-cart-drawer__qty">
                      <button type="button" class="aesop-cart-drawer__qty-btn" data-cart-qty-minus data-key="${item.key}">−</button>
                      <input type="number" class="aesop-cart-drawer__qty-input" value="${item.quantity}" min="0" data-cart-qty-input data-key="${item.key}" readonly>
                      <button type="button" class="aesop-cart-drawer__qty-btn" data-cart-qty-plus data-key="${item.key}">+</button>
                    </div>
                    <div class="aesop-cart-drawer__item-price">${formatMoney(item.final_line_price)}</div>
                  </div>
                </div>
              </div>`;
          });
          itemsHtml += '</div>';

          const footerHtml = `
            <div class="aesop-cart-drawer__samples">
              <button type="button" class="aesop-cart-drawer__samples-toggle" data-samples-toggle>
                <div>
                  <span class="aesop-cart-drawer__samples-title">Add your free Samples</span>
                  <span class="aesop-cart-drawer__samples-sub">You have 0 / 3 samples selected</span>
                </div>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <div class="aesop-cart-drawer__samples-content" data-samples-content hidden>
                <p class="aesop-cart-drawer__samples-empty">No samples available at this moment.</p>
              </div>
            </div>
            <div class="aesop-cart-drawer__footer">
              <div class="aesop-cart-drawer__subtotal">
                <span class="aesop-cart-drawer__subtotal-label">Subtotal</span>
                <span class="aesop-cart-drawer__subtotal-value">${formatMoney(cart.total_price)}</span>
              </div>
              <p class="aesop-cart-drawer__tax-note">
                Taxes included. Complimentary <a href="/policies/shipping-policy">Shipping</a> on all orders
              </p>
              <a href="/cart" class="aesop-cart-drawer__btn aesop-cart-drawer__btn--primary">Go to cart</a>
              <form action="/cart" method="post" novalidate class="aesop-cart-drawer__checkout-form">
                <button type="submit" name="checkout" class="aesop-cart-drawer__btn aesop-cart-drawer__btn--secondary">Check out</button>
              </form>
            </div>`;

          body.innerHTML = itemsHtml + footerHtml;

          body.querySelectorAll('[data-cart-qty-plus]').forEach(btn => {
            btn.addEventListener('click', function() {
              const input = body.querySelector(`[data-cart-qty-input][data-key="${this.dataset.key}"]`);
              updateCartItem(this.dataset.key, parseInt(input.value) + 1);
            });
          });
          body.querySelectorAll('[data-cart-qty-minus]').forEach(btn => {
            btn.addEventListener('click', function() {
              const input = body.querySelector(`[data-cart-qty-input][data-key="${this.dataset.key}"]`);
              updateCartItem(this.dataset.key, Math.max(0, parseInt(input.value) - 1));
            });
          });
        }
      }

      function formatMoney(cents) {
        return 'AED ' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      }

      document.addEventListener('click', function(e) {
        const toggle = e.target.closest('[data-samples-toggle]');
        if (toggle) {
          const content = toggle.nextElementSibling;
          if (content) content.hidden = !content.hidden;
        }
      });
    }
  });
</script>

