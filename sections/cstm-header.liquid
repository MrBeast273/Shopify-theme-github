{{ 'header-aesop.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign menu = linklists[section.settings.main_menu]

  assign overlay = false
  if template.name == 'index' and section.settings.transparent_home
    assign overlay = true
  elsif template.name == 'collection' and section.settings.transparent_collection
    assign overlay = true
  elsif template.name == 'page' and section.settings.transparent_page
    assign overlay = true
  endif

  assign suggestions = section.settings.suggested_searches | newline_to_br | strip_newlines | split: '<br />'
-%}

<div
  class="aesop-root"
  style="
    --aesop-bg: {{ section.settings.bg_color }};
    --aesop-text: {{ section.settings.text_color }};
    --aesop-line: {{ section.settings.line_color }};
    --aesop-logo-w: {{ section.settings.logo_width }}px;
  "
>
  <div
    role="banner"
    class="aesop-header{% unless overlay %} is-solid{% endunless %}"
    data-aesop-header
    data-overlay="{{ overlay }}"
    data-hide-on-scroll="{{ section.settings.hide_on_scroll }}"
    data-section-id="{{ section.id }}"
  >
    <a class="aesop-skip" href="#MainContent">Skip to content</a>

    <div class="aesop-header__top">
      <div class="aesop-header__group aesop-header__group--start">
        <button
          type="button"
          class="aesop-header__icon-btn aesop-header__menu-toggle"
          data-drawer-open
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="aesop-drawer-{{ section.id }}"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <line x1="3" y1="7" x2="21" y2="7"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="17" x2="21" y2="17"></line>
          </svg>
        </button>

        <a href="{{ section.settings.stores_url | default: '#' }}" class="aesop-header__link is-desktop-only">
          {{ section.settings.stores_label }}
        </a>
        <a href="{{ section.settings.contact_url | default: '#' }}" class="aesop-header__link is-desktop-only">
          {{ section.settings.contact_label }}
        </a>
      </div>

      <div class="aesop-header__logo">
        <a href="{{ routes.root_url }}" class="aesop-header__logo-link" aria-label="{{ shop.name | escape }}">
          {%- if section.settings.logo != blank -%}
            <span class="aesop-header__logo-stack">
              {%- if section.settings.logo_light != blank -%}
                {{
                  section.settings.logo_light
                  | image_url: width: 420
                  | image_tag:
                    class: 'aesop-header__logo-img aesop-header__logo-img--light',
                    alt: '',
                    loading: 'eager',
                    widths: '140, 280, 420',
                    sizes: '(min-width: 990px) 140px, 100px'
                }}
                {{
                  section.settings.logo
                  | image_url: width: 420
                  | image_tag:
                    class: 'aesop-header__logo-img aesop-header__logo-img--dark',
                    alt: '',
                    loading: 'eager',
                    widths: '140, 280, 420',
                    sizes: '(min-width: 990px) 140px, 100px'
                }}
              {%- else -%}
                {{
                  section.settings.logo
                  | image_url: width: 420
                  | image_tag:
                    class: 'aesop-header__logo-img aesop-header__logo-img--auto',
                    alt: '',
                    loading: 'eager',
                    widths: '140, 280, 420',
                    sizes: '(min-width: 990px) 140px, 100px'
                }}
              {%- endif -%}
            </span>
          {%- else -%}
            <span class="aesop-header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <div class="aesop-header__group aesop-header__group--end">
        <button
          type="button"
          class="aesop-header__icon-btn aesop-header__search-icon"
          data-search-open
          aria-label="{{ section.settings.search_label | escape }}"
          aria-expanded="false"
          aria-controls="aesop-search-{{ section.id }}"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
        </button>

        <a
          href="{{ section.settings.language_url | default: '#' }}"
          class="aesop-header__link is-desktop-only"
          lang="ar"
          data-language-switcher
        >
          {{ section.settings.language_label }}
        </a>

        <a href="#" class="aesop-header__link is-desktop-only" data-email-signup>
          {{ section.settings.email_signup_label }}
        </a>

        <a href="{{ routes.account_url }}" class="aesop-header__link is-desktop-only">
          {{ section.settings.account_label }}
        </a>

        <a href="{{ section.settings.cabinet_url | default: routes.account_url }}" class="aesop-header__link is-desktop-only">
          {{ section.settings.cabinet_label }}
        </a>

        <a
          href="{{ routes.cart_url }}"
          class="aesop-header__link aesop-header__cart-link"
          data-cart-drawer-open
          aria-label="{{ section.settings.cart_label | escape }}, {{ cart.item_count }} items"
        >
          {{- section.settings.cart_label -}}
          <span class="aesop-header__cart-count" data-cart-count-wrap{% if cart.item_count == 0 %} hidden{% endif %}>
            &nbsp;(<span data-cart-count>{{ cart.item_count }}</span>)
          </span>
        </a>
      </div>
    </div>

    <nav class="aesop-header__nav" aria-label="Main menu">
      <ul class="aesop-header__nav-list">
        {%- for link in menu.links -%}
          {%- liquid
            assign link_key = link.title | strip | downcase
            assign card_count = 0
            for block in section.blocks
              assign block_key = block.settings.menu_item | strip | downcase
              if block_key == link_key
                assign card_count = card_count | plus: 1
              endif
            endfor
            assign col_count = link.links.size | plus: card_count
          -%}

          <li
            class="aesop-header__nav-item{% if link.active or link.child_active %} is-active{% endif %}"
            {% if col_count > 0 %}data-mega-item{% endif %}
          >
            <a
              href="{{ link.url }}"
              class="aesop-header__nav-link"
              {% if col_count > 0 %}
                data-mega-trigger
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="aesop-mega-{{ section.id }}-{{ forloop.index }}"
              {% endif %}
              {% if link.current %}aria-current="page"{% endif %}
            >
              {{- link.title -}}
            </a>

            {%- if col_count > 0 -%}
              <div
                class="aesop-mega"
                id="aesop-mega-{{ section.id }}-{{ forloop.index }}"
                style="--cols: {{ col_count }};"
              >
                <div class="aesop-mega__inner">
                  {%- for group in link.links -%}
                    <div class="aesop-mega__col">
                      {%- if group.links.size > 0 -%}
                        <p class="aesop-mega__heading">{{ group.title }}</p>
                        <ul class="aesop-mega__list">
                          {%- for child in group.links -%}
                            <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- else -%}
                        <ul class="aesop-mega__list">
                          <li><a href="{{ group.url }}">{{ group.title }}</a></li>
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}

                  {%- for block in section.blocks -%}
                    {%- assign block_key = block.settings.menu_item | strip | downcase -%}
                    {%- if block_key == link_key -%}
                      {%- if block.type == 'menu_column' -%}
                        <div class="aesop-mega__col" {{ block.shopify_attributes }}>
                          {%- if block.settings.heading != blank -%}
                            <p class="aesop-mega__heading">{{ block.settings.heading }}</p>
                          {%- endif -%}
                          <ul class="aesop-mega__list">
                            {%- for child in block.settings.links.links -%}
                              <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- else -%}
                        <div class="aesop-mega__col" {{ block.shopify_attributes }}>
                          <a href="{{ block.settings.url | default: link.url }}" class="aesop-mega__card">
                            <span class="aesop-mega__card-media">
                              {%- if block.settings.image != blank -%}
                                {{
                                  block.settings.image
                                  | image_url: width: 480
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '240, 360, 480',
                                    sizes: '(min-width: 990px) 15vw, 240px',
                                    alt: block.settings.label,
                                    class: 'aesop-mega__card-img'
                                }}
                              {%- endif -%}
                            </span>
                            <span class="aesop-mega__card-label">{{ block.settings.label }}</span>
                          </a>
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="aesop-header__search-wrap">
        <button
          type="button"
          class="aesop-header__search-trigger"
          data-search-open
          aria-expanded="false"
          aria-controls="aesop-search-{{ section.id }}"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
          <span>{{ section.settings.search_label }}</span>
        </button>
      </div>
    </nav>

    <div
      class="aesop-search"
      id="aesop-search-{{ section.id }}"
      data-search-panel
      aria-hidden="true"
    >
      <div class="aesop-search__inner">
        <form action="{{ routes.search_url }}" method="get" role="search" class="aesop-search__form">
          <input type="hidden" name="options[prefix]" value="last">
          <input
            type="search"
            name="q"
            class="aesop-search__input"
            placeholder="{{ section.settings.search_placeholder | escape }}"
            aria-label="{{ section.settings.search_placeholder | escape }}"
            autocomplete="off"
            data-search-input
          >
          <button type="submit" class="aesop-header__icon-btn" aria-label="Search">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
            </svg>
          </button>
          <button type="button" class="aesop-search__close" data-search-close>Close</button>
        </form>

        {%- if suggestions.size > 0 and suggestions.first != blank -%}
          <div class="aesop-search__suggested" data-search-suggested>
            <p class="aesop-mega__heading">Suggested</p>
            <ul class="aesop-mega__list">
              {%- for term in suggestions -%}
                {%- assign term_clean = term | strip -%}
                {%- if term_clean != blank -%}
                  <li>
                    <a href="{{ routes.search_url }}?q={{ term_clean | url_encode }}&options[prefix]=last">{{ term_clean }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div
          class="aesop-search__results"
          data-search-results
          data-empty-text="No results found"
          data-all-text="View all results"
          aria-live="polite"
        ></div>
      </div>
    </div>
  </div>

  <div class="aesop-drawer" id="aesop-drawer-{{ section.id }}" data-drawer aria-hidden="true">
    <div class="aesop-drawer__overlay" data-drawer-close></div>
    <div class="aesop-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="aesop-drawer__head">
        <button type="button" class="aesop-header__icon-btn" data-drawer-close aria-label="Close menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <line x1="5" y1="5" x2="19" y2="19"></line>
            <line x1="19" y1="5" x2="5" y2="19"></line>
          </svg>
        </button>
      </div>

      <ul class="aesop-drawer__list">
        {%- for link in menu.links -%}
          <li class="aesop-drawer__item">
            {%- if link.links.size > 0 -%}
              <button
                type="button"
                class="aesop-drawer__accordion"
                data-accordion-trigger
                aria-expanded="false"
                aria-controls="aesop-drawer-panel-{{ section.id }}-{{ forloop.index }}"
              >
                {{ link.title }}
              </button>
              <div class="aesop-drawer__sub" id="aesop-drawer-panel-{{ section.id }}-{{ forloop.index }}" hidden>
                <a href="{{ link.url }}" class="aesop-drawer__sub-link aesop-drawer__sub-link--all">{{ link.title }}</a>
                {%- for group in link.links -%}
                  {%- if group.links.size > 0 -%}
                    <p class="aesop-mega__heading">{{ group.title }}</p>
                    <ul class="aesop-mega__list">
                      {%- for child in group.links -%}
                        <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- else -%}
                    <ul class="aesop-mega__list">
                      <li><a href="{{ group.url }}">{{ group.title }}</a></li>
                    </ul>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- else -%}
              <a href="{{ link.url }}" class="aesop-drawer__link">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="aesop-drawer__utility">
        <a href="{{ section.settings.stores_url | default: '#' }}">{{ section.settings.stores_label }}</a>
        <a href="{{ section.settings.contact_url | default: '#' }}">{{ section.settings.contact_label }}</a>
        <a href="{{ routes.account_url }}">{{ section.settings.account_label }}</a>
        <a href="{{ section.settings.cabinet_url | default: routes.account_url }}">{{ section.settings.cabinet_label }}</a>
        <a href="#" data-email-signup>{{ section.settings.email_signup_label }}</a>
        <a href="{{ section.settings.language_url | default: '#' }}" lang="ar">{{ section.settings.language_label }}</a>
      </div>
    </div>
  </div>

  <div class="aesop-cart-drawer" data-cart-drawer aria-hidden="true">
    <div class="aesop-cart-drawer__overlay" data-cart-close></div>
    
    <div class="aesop-cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Shopping cart">
      
      <div class="aesop-cart-drawer__head">
        <h2 class="aesop-cart-drawer__title">
          My cart <span data-cart-drawer-count>{% if cart.item_count > 0 %}({{ cart.item_count }}){% endif %}</span>
        </h2>
        <button type="button" class="aesop-cart-drawer__close" data-cart-close aria-label="Close cart">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="5" y1="5" x2="19" y2="19"></line>
            <line x1="19" y1="5" x2="5" y2="19"></line>
          </svg>
        </button>
      </div>

      <div class="aesop-cart-drawer__body" data-cart-body>
        {% if cart.item_count == 0 %}
          <div class="aesop-cart-drawer__empty">
            <p class="aesop-cart-drawer__empty-text">You have no items in your cart</p>
            <a href="{{ routes.all_products_collection_url }}" class="aesop-cart-drawer__empty-btn">Continue shopping</a>
          </div>
        {% else %}
          <div class="aesop-cart-drawer__items">
            {% for item in cart.items %}
              <div class="aesop-cart-drawer__item" data-cart-item="{{ item.key }}">
                
                <div class="aesop-cart-drawer__item-image">
                  <a href="{{ item.url }}">
                    <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title | escape }}" loading="lazy">
                  </a>
                </div>

                <div class="aesop-cart-drawer__item-details">
                  <a href="{{ item.url }}" class="aesop-cart-drawer__item-title">{{ item.product.title }}</a>
                  
                  {%- if item.product.has_only_default_variant == false -%}
                    <p class="aesop-cart-drawer__item-variant">
                      Size: {{ item.variant.title }}
                    </p>
                  {%- endif -%}

                  <div class="aesop-cart-drawer__item-bottom">
                    <div class="aesop-cart-drawer__qty">
                      <button type="button" class="aesop-cart-drawer__qty-btn" data-cart-qty-minus data-key="{{ item.key }}">−</button>
                      <input type="number" class="aesop-cart-drawer__qty-input" value="{{ item.quantity }}" min="0" data-cart-qty-input data-key="{{ item.key }}" readonly>
                      <button type="button" class="aesop-cart-drawer__qty-btn" data-cart-qty-plus data-key="{{ item.key }}">+</button>
                    </div>

                    <div class="aesop-cart-drawer__item-price">
                      {{ item.final_line_price | money }}
                    </div>
                  </div>
                </div>

              </div>
            {% endfor %}
          </div>

          <div class="aesop-cart-drawer__samples">
            <button type="button" class="aesop-cart-drawer__samples-toggle" data-samples-toggle>
              <div>
                <span class="aesop-cart-drawer__samples-title">Add your free Samples</span>
                <span class="aesop-cart-drawer__samples-sub">You have 0 / 3 samples selected</span>
              </div>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="aesop-cart-drawer__samples-content" data-samples-content hidden>
              <p class="aesop-cart-drawer__samples-empty">No samples available at this moment.</p>
            </div>
          </div>

          <div class="aesop-cart-drawer__footer">
            <div class="aesop-cart-drawer__subtotal">
              <span class="aesop-cart-drawer__subtotal-label">Subtotal</span>
              <span class="aesop-cart-drawer__subtotal-value" data-cart-subtotal>{{ cart.total_price | money }}</span>
            </div>
            
            <p class="aesop-cart-drawer__tax-note">
              Taxes included. Complimentary <a href="/policies/shipping-policy">Shipping</a> on all orders
            </p>

            <a href="{{ routes.cart_url }}" class="aesop-cart-drawer__btn aesop-cart-drawer__btn--primary">
              Go to cart
            </a>
            
            <form action="{{ routes.cart_url }}" method="post" novalidate class="aesop-cart-drawer__checkout-form">
              <button type="submit" name="checkout" class="aesop-cart-drawer__btn aesop-cart-drawer__btn--secondary">
                Check out
              </button>
            </form>
          </div>
        {% endif %}
      </div>

    </div>
  </div>

  <div class="aesop-modal" data-email-modal aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="aesop-modal-title-{{ section.id }}">
    <div class="aesop-modal__overlay" data-email-modal-close></div>
    <div class="aesop-modal__content">
      <button type="button" class="aesop-modal__close" data-email-modal-close aria-label="Close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>

      <div class="aesop-modal__media">
        {% if section.settings.email_modal_image != blank %}
          {{ section.settings.email_modal_image | image_url: width: 800 | image_tag: class: 'aesop-modal__image', loading: 'lazy' }}
        {% else %}
          <div class="aesop-modal__placeholder">
             {{ 'lifestyle-1' | placeholder_svg_tag: 'aesop-modal__svg' }}
          </div>
        {% endif %}
      </div>

      <div class="aesop-modal__form-wrap">
        <h2 class="aesop-modal__title" id="aesop-modal-title-{{ section.id }}">{{ section.settings.email_modal_title }}</h2>
        <p class="aesop-modal__text">{{ section.settings.email_modal_text }}</p>

        {%- form 'customer', class: 'aesop-modal__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <div class="aesop-modal__success">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              <span>Thanks for subscribing</span>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="aesop-modal__error">
              <span>{{ form.errors | default_errors }}</span>
            </div>
          {%- endif -%}

          <p class="aesop-modal__label">Subscribe to Aesop communications</p>
          
          <input
            type="email"
            name="contact[email]"
            class="aesop-modal__input"
            placeholder="Email address*"
            required
            autocomplete="email"
            aria-label="Email address"
          >

          <label class="aesop-modal__checkbox-label">
            <input type="checkbox" required>
            <span>{{ section.settings.email_modal_consent }}</span>
          </label>

          <button type="submit" class="aesop-modal__button">Submit</button>
        {%- endform -%}
      </div>

    </div>
  </div>
</div>

<script src="{{ 'header-aesop.js' | asset_url }}" defer></script>

<style>
  .aesop-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .aesop-modal.is-open {
    display: flex;
  }

  .aesop-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(2px);
  }

  .aesop-modal__content {
    position: relative;
    background: #FBFBF9;
    width: 100%;
    max-width: 900px;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
    overflow: hidden;
    margin: 20px;
    max-height: 90vh;
  }

  .aesop-modal__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 10;
    background: transparent;
    border: none;
    cursor: pointer;
    color: #333;
    padding: 5px;
    transition: opacity 0.2s;
  }
  .aesop-modal__close:hover { opacity: 0.6; }

  .aesop-modal__media {
    position: relative;
    background: #e8e5dc;
    min-height: 500px;
  }
  .aesop-modal__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .aesop-modal__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
  }
  .aesop-modal__svg { width: 50%; height: 50%; opacity: 0.4; }

  .aesop-modal__form-wrap {
    padding: 60px 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow-y: auto;
  }

  .aesop-modal__title {
    font-family: "Zapf Humanist", "Optima", "Georgia", serif;
    font-size: 32px;
    font-weight: 300;
    margin: 0 0 16px 0;
    color: #222;
